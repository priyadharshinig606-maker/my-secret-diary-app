<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1F8"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:id="@+id/tvDiaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:text="My Diary 📖"
            android:textColor="#4A235A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Date -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Monday, August 31, 2026"
            android:textColor="#666666"
            android:textSize="16sp" />

        <!-- Diary Entry Title -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/edit_text"
            android:hint="Give your day a title..."
            android:padding="15dp"
            android:textSize="18sp" />

        <!-- Mood Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="How are you feeling today?"
            android:textColor="#4A235A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Mood Selection -->
        <RadioGroup
            android:id="@+id/moodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbHappy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="😊 Happy" />

            <RadioButton
                android:id="@+id/rbSad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="😢 Sad" />

            <RadioButton
                android:id="@+id/rbAngry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="😡 Angry" />

        </RadioGroup>

        <!-- Diary Content Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Dear Diary..."
            android:textColor="#4A235A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Diary Writing Area -->
        <EditText
            android:id="@+id/etDiaryContent"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="25dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top|start"
            android:hint="Write your thoughts, memories and feelings here..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="15dp"
            android:textSize="17sp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveDiary"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#7D3C98"
            android:text="💾 SAVE MY DIARY"/>
        <Button
            android:id="@+id/btnViewDiary"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VIEW ALL DIARIES"/>

        <Button
            android:id="@+id/btnDeleteDiary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DELETE DIARY"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</ScrollView>